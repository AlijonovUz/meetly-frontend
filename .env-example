# ==============================================================================
# MEETLY FRONTEND - ATROF-MUHIT SOZLAMALARI (.env)
# ==============================================================================

# Backend REST API manzili (oxirida /api/v1 bilan)
# - Lokal developmentda: http://localhost:8001/api/v1 (yoki http://94.130.134.99:8001/api/v1)
# - Productionda: https://api.meetly.uz/api/v1
VITE_BASE_URL=http://94.130.134.99:8001/api/v1

# Django Channels WebSocket manzili (bildirishnomalar va chat uchun)
# - Lokal developmentda: ws://localhost:8001 (yoki ws://94.130.134.99:8001)
# - Productionda: wss://api.meetly.uz
VITE_WS_URL=wss://api.meetly.uz

# Frontend o'zining asosiy manzili
# - Lokal developmentda: http://localhost:3000
# - Productionda: https://meetly.uz
VITE_FRONTEND_URL=https://meetly.uz

# Authly SSO foydalanuvchi kabineti manzili (shaxsiy ma'lumotlarni tahrirlash uchun)
VITE_AUTHLY_FRONTEND_URL=https://authly.uz
